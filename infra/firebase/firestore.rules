rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns a document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Canonical admin authorization: legacy Super Admin emails remain supported,
    // while all new access comes from adminUsers group-derived permissions.
    function hasAdminPermission(permission) {
      return isSignedIn() && (
        request.auth.token.email == 'christianmatchghanaltd@gmail.com' ||
        request.auth.token.email == 'admin@example.com' ||
        (
          exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isSuperAdmin == true ||
            permission in get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.permissions
          )
        )
      );
    }

    function isAdmin() {
      return hasAdminPermission('users.view');
    }
    
    // ============================================
    function canUpdateProfileFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinHash', 'hasPin']);
    }

    // RBAC ACCESS CONTROL
    // ============================================
    match /adminUsers/{userId} {
      allow read: if isOwner(userId) || hasAdminPermission('groups.manage');
      allow write: if false;
    }

    match /adminGroups/{groupId} {
      allow read: if hasAdminPermission('groups.manage');
      allow write: if false;
    }

    // Distribution-group definitions are server-owned. Admin clients use
    // callable functions so criteria validation and audit logging cannot be bypassed.
    match /adminDistributionGroups/{groupId} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if hasAdminPermission('audit.view');
      allow write: if false;
    }

    // ============================================
    // USERS/PROFILES COLLECTION
    // ============================================
    match /users/{userId} {
      // Anyone authenticated can browse profiles; administrative writes require specific permissions.
      allow read: if isSignedIn();
      allow create: if (isOwner(userId) || hasAdminPermission('users.create')) && !request.resource.data.keys().hasAny(['pinHash', 'hasPin']);
      allow update: if (isOwner(userId) && canUpdateProfileFields()) ||
        (hasAdminPermission('users.edit') && canUpdateProfileFields()) ||
        (hasAdminPermission('users.suspend') && canUpdateProfileFields() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBlocked', 'updatedAt']));
      allow delete: if isOwner(userId) || hasAdminPermission('users.delete');
      
      // Subcollection: User's uploaded files metadata
      match /files/{fileId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ============================================
    // CHATS COLLECTION
    // ============================================
    match /chats/{chatId} {
      // Users can only read chats they are part of
      allow read: if isSignedIn() && 
                     (request.auth.uid in resource.data.participants || isAdmin());
      
      // Users can create chats where they are a participant
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.participants;
      
      // Users can update chats they are part of
      allow update: if isSignedIn() && 
                       request.auth.uid in resource.data.participants;
      
      // Users can delete chats they are part of
      allow delete: if isSignedIn() && 
                       request.auth.uid in resource.data.participants;
    }
    
    // ============================================
    // MESSAGES COLLECTION
    // ============================================
    function isChatParticipant(chatId) {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        )
      );
    }

    match /messages/{messageId} {
      // A message can only be read by a participant in its chat.
      allow read: if isChatParticipant(resource.data.chatId);

      // The sender must be the authenticated Firebase user and must belong to
      // the chat. This prevents a stale profile/session from writing messages
      // under the wrong identity or into an unrelated conversation.
      allow create: if isChatParticipant(request.resource.data.chatId) &&
        request.resource.data.senderId == request.auth.uid;

      // Message content and ownership are immutable. Participants may only
      // update delivery/read state and reactions.
      allow update: if isChatParticipant(resource.data.chatId) &&
        request.resource.data.chatId == resource.data.chatId &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions']);

      allow delete: if isChatParticipant(resource.data.chatId) &&
        resource.data.senderId == request.auth.uid;
    }
    
    // ============================================
    // COMMUNITY/PRAYER REQUESTS COLLECTION
    // ============================================
    match /prayer_requests/{prayerId} {
      // Authenticated users can read prayers
      allow read: if isSignedIn();
      
      // Create: Users can create if they set themselves as owner
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      
      // Update: Owner can edit content. Everyone can update counters (pray/comment)
      allow update: if isSignedIn() && (
        isOwner(resource.data.userId) || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['prayingCount', 'prayedBy', 'commentCount'])
      );
      
      // Users can delete their own prayers or admins
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // ============================================
      // COMMENTS SUBCOLLECTION
      // ============================================
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }
    
    // ============================================
    // CALLS COLLECTION
    // ============================================
    function isCallParticipant(callId) {
      return isSignedIn() && exists(/databases/$(database)/documents/calls/$(callId)) && (
        request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
        request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
      );
    }

    function validCallStatus(status) {
      return status in ['ringing', 'accepted', 'connecting', 'connected', 'rejected', 'missed', 'ended', 'failed', 'expired'];
    }

    match /calls/{callId} {
      // Existing call documents may only be read by the caller or receiver.
      allow get: if isCallParticipant(callId);

      // The receiver uses this constrained query to discover ringing calls.
      // Keep the list permission limited to the authenticated receiver and
      // ringing status so users cannot enumerate other calls.
      allow list: if isSignedIn() &&
        resource.data.receiverId == request.auth.uid &&
        resource.data.status == 'ringing';

      allow create: if isSignedIn() &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid &&
        request.resource.data.chatId is string &&
        exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
        request.resource.data.receiverId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
        request.resource.data.status == 'ringing' &&
        validCallStatus(request.resource.data.status);

      allow update: if isCallParticipant(callId) &&
        request.resource.data.callerId == resource.data.callerId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.chatId == resource.data.chatId &&
        validCallStatus(request.resource.data.status) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'offer', 'answer', 'acceptedAt', 'connectedAt', 'endedAt', 'expiresAt', 'failedAt'
        ]);

      allow delete: if isCallParticipant(callId);

      match /candidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isCallParticipant(callId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['senderId', 'candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment', 'createdAt']);
        allow delete: if isCallParticipant(callId);
      }
    }
    
    // ============================================
    // BLOCKS COLLECTION
    // ============================================
    match /blocks/{blockId} {
      allow read, write: if isSignedIn();
    }
    // ============================================
    // SUPPORT TICKETS
    // ============================================
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // PRESENCE COLLECTION (online status)
    // ============================================
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ============================================
    // PAYMENTS COLLECTION
    // ============================================
    match /payments/{paymentId} {
      allow read: if hasAdminPermission('payments.view') || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if hasAdminPermission('subscriptions.manage');
    }
  }
}
