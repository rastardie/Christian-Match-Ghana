# Stormer Host (cPanel) deploy credentials — COPY to stormerhost.env and fill in.
# NEVER commit the real stormerhost.env. It is git-ignored.

# Transport: sftp (recommended, port 22) or ftp (port 21)
CMG_DEPLOY_PROTOCOL=sftp
CMG_DEPLOY_HOST=your-cpanel-host.stormerhost.com
CMG_DEPLOY_PORT=22
CMG_DEPLOY_USER=your-cpanel-username
CMG_DEPLOY_PASS=your-cpanel-password

# Remote document root (usually public_html)
CMG_DEPLOY_REMOTE_DIR=public_html

# Optional safety switches
# Back up the current remote document root locally before uploading (true/false)
CMG_DEPLOY_BACKUP=true
# Delete remote files that are not present locally (true/false). Leave false unless
# public_html contains ONLY this app, otherwise unrelated files could be removed.
CMG_DEPLOY_DELETE=false
