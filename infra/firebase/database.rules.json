{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastSeen']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && newData.child('lastSeen').isNumber()"
      }
    }
  }
}
