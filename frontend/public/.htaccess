<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed build assets are immutable and safe to cache long-term.
  <FilesMatch "\.(?:js|mjs|css|woff2?|ttf|eot|otf|png|jpe?g|gif|svg|webp|avif|ico|wav|mp3|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # App shell, service worker and web manifest must always be revalidated so a
  # new deploy is picked up on first load (no stale index.html -> old app).
  # Placed AFTER the asset rule so it overrides it for these specific files.
  <FilesMatch "^(index\.html|firebase-messaging-sw\.js|manifest\.json|robots\.txt|_redirects)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
