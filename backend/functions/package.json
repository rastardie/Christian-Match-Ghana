    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "src/index.js",
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "nodemailer": "10.1.0"
  },
  "private": true,
  "devDependencies": {
    "firebase-tools": "15.33.0",
    "picomatch": "4.0.7"
  }
}
